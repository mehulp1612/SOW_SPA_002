{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safi.example/schemas/root-spa.schema.json",
  "title": "Root SPA Initial Context",
  "description": "Constrained, non-executable content and presentation settings for one Root SPA instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "templateVersion",
    "pathName",
    "displayName",
    "title",
    "subtitle",
    "theme",
    "sections"
  ],
  "properties": {
    "templateVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "pathName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "theme": {
      "type": "string",
      "enum": ["coast", "citrus", "earth"]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "heading", "body"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 40
          },
          "type": {
            "type": "string",
            "enum": ["story", "features", "call-to-action"]
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "linkLabel": {
            "type": "string",
            "maxLength": 40
          },
          "linkHref": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(https://|mailto:|#)[^\\s]*$"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "features" } }, "required": ["type"] },
            "then": { "required": ["items"], "properties": { "items": { "type": "array", "minItems": 1 } } }
          },
          {
            "if": { "properties": { "type": { "const": "call-to-action" } }, "required": ["type"] },
            "then": {
              "required": ["linkLabel", "linkHref"],
              "properties": {
                "linkLabel": { "type": "string" },
                "linkHref": { "type": "string" }
              }
            }
          }
        ]
      }
    }
  }
}
